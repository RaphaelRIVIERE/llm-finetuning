{
  "info": {
    "name": "Agent de triage CHSA",
    "description": "Démo et tests de l'API de triage. Renseigner les variables base_url et api_key avant de lancer. Réveiller l'API par un appel sur Santé quelques minutes avant : le démarrage à froid peut prendre plusieurs minutes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://raphaelriviere06--triage-chsa-api.modal.run"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "dernier_id",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 200) {",
          "    const r = pm.response.json();",
          "    pm.test(\"niveau dans la liste\", () => pm.expect([\"maximum\", \"moderate\", \"deferred\"]).to.include(r.urgency_level));",
          "    pm.test(\"justification présente\", () => pm.expect(r.justification).to.be.a(\"string\").and.not.empty);",
          "    pm.test(\"interaction_id renvoyé\", () => pm.expect(r.interaction_id).to.be.a(\"number\"));",
          "    // Sert à retrouver l'échange dans Neon pour l'audit.",
          "    pm.collectionVariables.set(\"dernier_id\", r.interaction_id);",
          "}"
        ]
      }
    }
  ],
