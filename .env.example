HF_TOKEN=your_token_here

# Postgres local, utilisé par docker-compose.yml
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage
POSTGRES_DB=triage

# URL utilisée par l'API pour se connecter à la base.
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/triage

# Clé à passer dans le header X-API-Key pour appeler /triage.
# Pour en générer une : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_api_key_here
